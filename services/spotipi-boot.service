[Unit]
Description=SpotiPi Boot Orchestrator
After=network.target
Wants=network.target

[Service]
Type=oneshot
User=pi
Group=pi
Environment=HOME=/home/pi
RemainAfterExit=yes
ExecStart=/opt/spotipi/boot/spotipi-boot.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=spotipi-boot

[Install]
WantedBy=multi-user.target
