[Unit]
Description=SpotiPi Spotify Authorization
After=network-online.target
Wants=network-online.target
Conflicts=spotipi.service spotipi-wifi.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/spotipi
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/pi
# Run auth flow under a minimal X session so pygame QR can render on HDMI.
ExecStart=/usr/bin/xinit /opt/spotipi/venv/bin/python3 /opt/spotipi/auth/spotify_auth.py -- :0 vt1 -nocursor -nolisten tcp
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=spotipi-auth

[Install]
WantedBy=multi-user.target
