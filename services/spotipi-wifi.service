[Unit]
Description=SpotiPi WiFi Setup (AP + Captive Portal)
After=network.target
Conflicts=spotipi.service spotipi-auth.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/spotipi
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/pi
# Run WiFi setup under a minimal X session so wifi_qr.py can render.
ExecStart=/usr/bin/xinit /opt/spotipi/venv/bin/python3 /opt/spotipi/wifi/wifi_setup.py -- :0 vt1 -nocursor -nolisten tcp
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=spotipi-wifi

[Install]
WantedBy=multi-user.target
