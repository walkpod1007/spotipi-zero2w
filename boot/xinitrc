#!/bin/bash
# ~/.xinitrc — SpotiPi X11 session orchestrator
# Runs after `startx` from .bashrc (autologin on tty1)
# State machine: WiFi setup → Spotify auth → Chromium kiosk

xset s off
xset -dpms
xset s noblank

PROJ="/opt/spotipi"
VENV="$PROJ/venv/bin/python3"
TOKEN_PATH="$HOME/.spotipi/token.json"

while true; do
    WIFI_SSID=$(iwgetid -r 2>/dev/null || true)

    if [[ -z "$WIFI_SSID" ]]; then
        # No WiFi — show QR code to join setup AP and configure network
        "$VENV" "$PROJ/wifi/wifi_qr.py"
        sleep 2

    elif [[ ! -f "$TOKEN_PATH" ]]; then
        # WiFi OK but no Spotify token — run OAuth flow (shows QR on screen)
        "$VENV" "$PROJ/auth/spotify_auth.py"
        sleep 1

    else
        # Fully configured — start Flask backend then launch Chromium kiosk
        "$VENV" "$PROJ/display/app.py" &
        BACKEND_PID=$!

        # Wait up to 30s for Flask to be ready
        for i in $(seq 1 30); do
            curl -sf http://localhost:5000/health >/dev/null 2>&1 && break
            sleep 1
        done

        exec chromium-browser \
            --kiosk \
            --noerrdialogs \
            --disable-infobars \
            --no-first-run \
            --disable-session-crashed-bubble \
            --disable-restore-session-state \
            --app=http://localhost:5000

        # If chromium exits (shouldn't happen in kiosk), kill backend and retry
        kill "$BACKEND_PID" 2>/dev/null
        sleep 3
    fi
done
